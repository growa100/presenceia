# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI APIs
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# App
NEXT_PUBLIC_APP_URL=https://presenceia.com

# Stripe (add when ready)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Auth
JWT_SECRET=generate-a-strong-secret-here

# Email (Resend)
RESEND_API_KEY=re_...

# Analyse gratuite (visibility check, engine v2). A platform without key is skipped.
GEMINI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
# Optional overrides (defaults in lib/geo/platforms.ts and lib/geo/analyst.ts)
# GEO_OPENAI_MODEL=gpt-5.6-luna
# GEO_CLAUDE_MODEL=claude-haiku-4-5
# GEO_GEMINI_MODEL=gemini-3.5-flash-lite
# GEO_ENABLE_GROK=1          (off by default: USD 0.045 per answer)
# GEO_GROK_MODEL=grok-4.3
# GEO_PERPLEXITY_PRESET=fast       (Perplexity Agent API preset)
# GEO_ANALYST_MODEL=claude-haiku-4-5
# GEO_CACHE_HOURS=168
# GEO_GEMINI_GROUNDING_PAID=1  (set once above 5,000 grounded requests per month)
# GEO_RATE_LIMIT=5          fresh checks per IP per hour
# GEO_DAILY_CAP=300         fresh checks per 24 h, all visitors
# IP_HASH_SALT=
